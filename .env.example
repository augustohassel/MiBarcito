# ==============================================================================
# Configuración Cliente de Firebase / Identity Platform (Opcional en local)
# ==============================================================================
# Si estas variables no están definidas, MiBarcito funciona automáticamente
# en modo 100% Local-First utilizando IndexedDB en el navegador.
#
# En producción (GitHub Pages), configurar estas 4 variables en:
# GitHub Repository -> Settings -> Secrets and variables -> Actions -> Variables
# ==============================================================================

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

